NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sonar
# Generate a random secret of at least 32 characters.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Passkey ceremony origin. Default in development: http://localhost:5173.
# In production, defaults to FRONTEND_URL and requires HTTPS.
# WEBAUTHN_ORIGIN=https://sonar.example.org
# Optional operator-controlled voice connectivity. No third-party ICE service by default.
STUN_URLS=
TURN_URLS=
# Coturn use-auth-secret/static-auth-secret shared secret; never expose it in a VITE variable.
TURN_SHARED_SECRET=
VOICE_RELAY_ONLY=false

# Optional shared authentication limits using this MongoDB (requires TTL index).
# Enable for multi-instance deployments after configuring trusted proxies.
MONGO_SHARED_AUTH_LIMITS=false
# Optional comma-separated trusted proxy IPs/CIDRs controlled by the operator.
# Leave blank when connecting directly; never use arbitrary client-supplied addresses.
TRUST_PROXY_CIDRS=
# Experimental device registration and direct messaging; recovery is incomplete.
# Leave disabled until the migration and security review are complete.
SONAR_MATRIX_EXPERIMENTAL=false
# Stable operator-controlled Matrix identity domain; changing it changes IDs.
MATRIX_SERVER_NAME=
# Maximum total encrypted attachment bytes (default: 1073741824; maximum: 10737418240).
# Used by the experimental web attachment feature; desktop UI is incomplete.
MATRIX_ATTACHMENT_GLOBAL_LIMIT_BYTES=1073741824
